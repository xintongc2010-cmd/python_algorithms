        self.unsorted_list = unsorted_list
        self.unsorted_list[index_from]
        self.unsorted_list[index_with]

    def sort(self) -> None:
         new_value = self.unsorted_list[index_from]
        self.unsorted_list[index_from] = self.unsorted_list[index_with]
        self.unsorted_list[index_with] = new_value
