class bubble_sort(sorting_algorithms):
    def __init__(self, unsorted_list, index_to_swap_from, index_to_swap_with):
        super().__init__(unsorted_list, index_to_swap_from, index_to_swap_with)

    def sort(self):
        length = len(self.unsorted_list)
        did_it_swap = True
        while did_it_swap == True:
            did_it_swap = False
    
            for index in range(0, length-1):
                element1 = self.unsorted_list[index]
                element2 = self.unsorted_list[index+1]
                if element1 > element2:
                    print(f'[To Swap] — {element1}, and {element2}')
                    self.unsorted_list = self.sort(self.unsorted_list, index, index+1)
                    did_it_swap = True
    
            print(f"[End of For Loop]Array looks like this now: {self.unsorted_list}")
            print(
                f"Does the array still need to be sorted / checked one last time? {did_it_swap}")
        return self.unsorted_list